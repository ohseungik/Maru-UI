{
  "name": "maru-ui-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "React + TypeScript 디자인 시스템 · CSS 변수 토큰 · a11y 테스트 · Storybook",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@ohseungik/maru-docs",
    "build": "turbo run build",
    "size": "node scripts/size-report.mjs",
    "verify:pack": "node scripts/verify-pack.mjs",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "test:visual": "pnpm --filter @ohseungik/maru-docs test:visual",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "release": "turbo run build --filter=./packages/* && node scripts/verify-pack.mjs && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@eslint/js": "^9.30.0",
    "eslint": "^9.30.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "turbo": "^2.11.11",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.72.2"
  }
}
