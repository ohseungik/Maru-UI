{
  "name": "@ohseungik/maru-ui",
  "version": "0.0.0",
  "description": "Accessible React components for Maru UI.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "react",
    "design-system",
    "components",
    "accessibility",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ohseungik/Maru-UI.git",
    "directory": "packages/components"
  },
  "homepage": "https://ohseungik.github.io/Maru-UI/",
  "bugs": {
    "url": "https://github.com/ohseungik/Maru-UI/issues"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "axe-core": "^4.10.3",
    "jsdom": "^30.1.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
