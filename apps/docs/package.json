{
  "name": "@ohseungik/maru-docs",
  "version": "0.0.0",
  "private": true,
  "description": "Storybook documentation site for Maru UI.",
  "type": "module",
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "storybook build -o storybook-static",
    "typecheck": "tsc --noEmit",
    "test:visual": "playwright test --config visual/playwright.config.ts",
    "test:visual:update": "playwright test --config visual/playwright.config.ts --update-snapshots"
  },
  "dependencies": {
    "@ohseungik/maru-tokens": "workspace:*",
    "@ohseungik/maru-ui": "workspace:*",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@storybook/addon-a11y": "^10.6.6",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/react-vite": "^10.6.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "storybook": "^10.6.6",
    "typescript": "~7.0.2",
    "vite": "^8.3.7"
  }
}
